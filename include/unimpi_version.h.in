#ifndef UNIMPI_VERSION_H
#define UNIMPI_VERSION_H

/* AUTO-GENERATED by CMake from include/unimpi_version.h.in - do not edit this
 * generated copy directly. The single source of truth for the library version
 * is CMakeLists.txt: project(VERSION ...) sets MAJOR/MINOR/PATCH, and
 * UNIMPI_VERSION_PRERELEASE sets the pre-release tag ("alpha"/"beta"/"rc"/"").
 * Re-run cmake to refresh this header after changing those values.
 */

#define UNIMPI_VERSION_MAJOR @unimpi_VERSION_MAJOR@
#define UNIMPI_VERSION_MINOR @unimpi_VERSION_MINOR@
#define UNIMPI_VERSION_PATCH @unimpi_VERSION_PATCH@
#define UNIMPI_VERSION_PRERELEASE "@UNIMPI_VERSION_PRERELEASE@"
#define UNIMPI_VERSION_STRING "@UNIMPI_VERSION_STRING@"

/* Numeric encoding: 0xMMNNPPPP (MM=major, NN=minor, PP=patch) for compile-time
 * comparisons. Pre-release tag deliberately excluded - numeric comparisons
 * operate on released-API surface only. */
#define UNIMPI_VERSION_NUMERICAL \
    (((UNIMPI_VERSION_MAJOR) << 24) | \
     ((UNIMPI_VERSION_MINOR) << 16) | \
     ((UNIMPI_VERSION_PATCH) << 0))

/* Runtime query (defined in src/core.c). Returns UNIMPI_VERSION_STRING. */
const char *unimpi_get_version(void);

/* ============================================================
 * Below: compile-time MPI target-version gating (unchanged).
 * The library and the application must be compiled with identical
 * UNIMPI_MPI_TARGET_VERSION / SUBVERSION (CMake INTERFACE propagates).
 * ============================================================ */

/* Compile-time target MPI version (user-overridable). Default = upper bound
 * of the library's surface support (currently 3.1). The library and the
 * application must be compiled with exactly the same pair of macros (CMake
 * INTERFACE propagation guarantees this). */
#ifndef UNIMPI_MPI_TARGET_VERSION
#define UNIMPI_MPI_TARGET_VERSION 3
#define UNIMPI_MPI_TARGET_SUBVERSION 1
#endif

#define UNIMPI_MPI_AT_LEAST(MJ, MN) \
    ((UNIMPI_MPI_TARGET_VERSION) > (MJ) || \
     ((UNIMPI_MPI_TARGET_VERSION) == (MJ) && \
      (UNIMPI_MPI_TARGET_SUBVERSION) >= (MN)))

#endif
